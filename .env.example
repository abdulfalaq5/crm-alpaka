# Salin ke .env lalu sesuaikan. File .env tidak masuk repo.

# ---- Port (backend & frontend membaca file ini) ----
BACKEND_PORT=9721
FRONTEND_PORT=9722
# URL backend untuk frontend build, hanya jika frontend & backend di subdomain/domain berbeda
# (mis. https://api.example.com/api). Kosongkan bila satu domain (proxy /api lewat nginx, lihat deploy/nginx/alpaka.conf).
# VITE_API_URL=https://api.example.com/api

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=db_crm_alpaka

# ---- Backend ----
NODE_ENV=development
JWT_SECRET=ganti-dengan-string-acak-panjang
SESSION_IDLE_MINUTES=30
CORS_ORIGIN=http://localhost:9722
FORCE_HTTPS=false
UPLOAD_DIR=uploads

# ---- Akun admin awal (dibuat otomatis bila tabel admins masih kosong) ----
ADMIN_NAME=Administrator Alpaka
ADMIN_EMAIL=admin@alpaka.local
ADMIN_PASSWORD=ganti-password-admin

# ---- Email notifikasi (SMTP) — kosongkan MAIL_HOST untuk menonaktifkan ----
# Development: pakai Mailtrap Sandbox (https://mailtrap.io) agar email tidak sampai ke penerima asli.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_ADDRESS=no-reply@alpaka.local
MAIL_FROM_NAME=Alpaka Loyalty
# MAIL_INTERVAL_MS=1100  # jeda antar email; default 1100 ms bila host Mailtrap
APP_URL=http://localhost:9722

# Dokumentasi API Swagger di /api/docs (default: aktif di development, nonaktif di production)
# SWAGGER_ENABLED=true

# Batas percobaan login per IP per 15 menit (default 30). Jangan dinaikkan di production.
# LOGIN_RATE_LIMIT=30
# Batas permintaan API per IP per menit (default 300)
# RATE_LIMIT_PER_MIN=300
