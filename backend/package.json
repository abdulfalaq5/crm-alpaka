{
  "name": "alpaka-loyalty-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API Sistem Loyalty Alpaka (Fase 1) — Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test tests/*.test.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed.js --demo",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.3",
    "swagger-ui-express": "^5.0.1"
  },
  "license": "UNLICENSED"
}
